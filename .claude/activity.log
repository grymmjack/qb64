  | SUB draw_ui
  |     DIM i AS LONG, y AS LONG, n AS LONG, v AS LONG, samples AS LONG
  |     DIM x0 AS LONG, x1 AS LONG, fy AS LONG, prevY AS LONG, lo AS DOUBLE, hi AS DOUBLE
