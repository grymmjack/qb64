  $ cat > $SP/probe.py <<'EOF'
  $ import zipfile, sqlite3, os, re, struct, sys, json
  $ from concurrent.futures import ThreadPoolExecutor
  $ G='/media/grymmjack/10_TB1/Emulation/eXoDOS/eXoDOS/Games'
  $ db=sqlite3.connect(os.path.expanduser('~/.cache/exodos-index/exodos.sqlite'))
  $ titles=[l.strip() for l in open(sys.argv[1])]
  $ zips=set(r[0] for r in db.execute("select zip from games where title||' ('||year||')' in (%s)"%','.join('?'*len(titles)),titles))
  $ zips|=set(r[0] for r in db.execute("select distinct g.zip from games g join files f on f.game_id=g.id where f.name like 'AUDIOHED.%' or f.name like 'AUDIOT.%' or f.ext='WAD'"))
  $ def ifs_scan(d):
  $     out=[]
  $     for m in re.finditer(b'SND\x00',d):
  $         p=m.start()
  $         if p+16>len(d): continue
  $         n=struct.unpack_from('<H',d,p+6)[0]
  $         if not 1<=n<=300 or p+16+n*16>len(d): continue
  $         ok=0; names=[]
  $         for i in range(n):
  $             e=p+16+i*16
  $             off=struct.unpack_from('<H',d,e)[0]; nm=d[e+4:e+16].split(b'\0')[0]
  $             if d[e+3]==8 and nm and all(32<=c<127 for c in nm) and 16+n*16<=off: ok+=1; names.append(nm.decode())
  $         if ok>=max(1,n*0.8): out.append((p,n,names[:6]))
  $     return out
  $ def dp_scan(d):
  $     if d[:4] not in (b'IWAD',b'PWAD'): return None
  $     n,o=struct.unpack_from('<ii',d,4); dp=set(); other=set()
  $     for i in range(n):
  $         if o+i*16+16>len(d): break
  $         fp,sz,nm=struct.unpack_from('<ii8s',d,o+i*16); nm=nm.split(b'\0')[0].decode('latin1').upper()
  $         if sz>=4 and fp+sz<=len(d) and d[fp]==0 and d[fp+1]==0 and struct.unpack_from('<H',d,fp+2)[0]==sz-4:
  $             (dp if nm.startswith('DP') else other).add(nm)
  $     return len(dp), sorted(other)[:10], len(other)
  $ def idaudio(files):
  $     res=[]
  $     for hn,hd in files.items():
  $         if not hn.startswith('AUDIOHED.'): continue
  $         tn='AUDIOT.'+hn.split('.')[1]
  $         if tn not in files: res.append((hn,'no AUDIOT')); continue
  $         h=hd; t=files[tn]
  $         offs=[struct.unpack_from('<I',h,i)[0] for i in range(0,len(h)-3,4)]
  $         pc=0
  $         for i in range(len(offs)-1):
  $             a,b=offs[i],offs[i+1]
  $             if b-a<6 or b>len(t): break
  $             ln=struct.unpack_from('<I',t,a)[0]
  $             if not (ln+6<=b-a<=ln+8): break
  $             pc+=1
  $         res.append((hn,len(offs)-1,pc))
  $     return res
  $ def one(z):
  $     r={'ifs':[],'wad':[],'id':[]}
  $     try:
  $         f=zipfile.ZipFile(os.path.join(G,z)); small={}
  $         for i in f.infolist():
  $             nm=i.filename.split('/')[-1].upper()
  $             if i.is_dir(): continue
  $             isw=nm.endswith('.WAD')
  $             if i.file_size>3_000_000 and not (isw and i.file_size<40_000_000): continue
  $             d=f.read(i)
  $             if nm.startswith('AUDIOHED.') or nm.startswith('AUDIOT.'): small[nm]=d
  $             if isw:
  $                 w=dp_scan(d)
  $                 if w: r['wad'].append((i.filename,)+w)
  $             else:
  $                 for hit in ifs_scan(d): r['ifs'].append((i.filename,)+hit)
  $         r['id']=idaudio(small)
  $     except Exception as e: r['err']=str(e)
  $     return z,r
  $ with ThreadPoolExecutor(8) as ex: res=dict(ex.map(one,sorted(zips)))
  $ json.dump(res,open(sys.argv[2],'w'),indent=0)
  $ for z,r in sorted(res.items()):
  $     if r.get('err'): print('ERR',z,r['err'])
  $     for x in r['ifs']: print('IFS ',z[:-4],'|',x)
  $     for x in r['id']: print('IDAU',z[:-4],'|',x)
  $     for x in r['wad']:
  $         if x[1] or x[3]: print('WAD ',z[:-4],'|',x)
  $ EOF
  $ time python3 $SP/probe.py $SP/apogee_titles.txt $SP/probe.json 2>&1 | tail -120
