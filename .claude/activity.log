  $     ('Finagle', r'AUDIO(HED|T)\.FNG'),
  $     ("On Disk Monthly's Circuitry", r'AUDIO(HED|T)\.CIR'),
  $     ('Duke Nukem II', r'NUKEM2\.CMP'),
  $     ('DOOM', r'DOOM\.WAD'),
  $     ('DOOM II', r'DOOM2\.WAD'),
  $     ('Final DOOM', r'(TNT|PLUTONIA)\.WAD'),
  $     ('Chex Quest 2', r'CHEX2?\.WAD'),
  $     ('Strife', r'STRIFE1\.WAD'),
  $     ('Rise of the Triad - Dark War', r'DARKWAR\.WAD'),
  $ ]
  $ db = sqlite3.connect(os.path.expanduser('~/.cache/exodos-index/exodos.sqlite'))
  $ os.makedirs(OUT, exist_ok=True)
  $ for title, rx in WANT:
  $     rows = db.execute("select g.zip, f.path, f.name from games g join files f on f.game_id=g.id where g.title=?", (title,)).fetchall()
  $     hits = [(z, p, n) for z, p, n in rows if re.fullmatch(rx, n)]
  $     if not hits:
  $         print('MISSING', title); continue
  $     with zipfile.ZipFile(os.path.join(G, hits[0][0])) as zf:
  $         done = set()
  $         for z, p, n in hits:
  $             if n in done: continue          # same file in several subfolders
  $             done.add(n)
  $             with zf.open(p) as src, open(os.path.join(OUT, n), 'wb') as dst:
  $                 dst.write(src.read())
  $     print(f'{title:45s} {" ".join(sorted(done))}')
