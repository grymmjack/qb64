'=======================================================================
'  UI.BM -- the widget layer
'=======================================================================

SUB AddWid (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, _
            k AS INTEGER, a AS INTEGER, g AS INTEGER, _
            lb AS STRING, tp AS STRING)
    IF nWid >= MAXWID THEN EXIT SUB
    wid(nWid).wx = x: wid(nWid).wy = y
    wid(nWid).ww = w: wid(nWid).wh = h
    wid(nWid).kind = k: wid(nWid).act = a: wid(nWid).arg = g
    wid(nWid).label = lb
    wid(nWid).tip = tp
    nWid = nWid + 1
END SUB

'  Built once, after InitPanel has set cpY.
SUB InitWidgets
    DIM i AS INTEGER, bx AS INTEGER, by AS INTEGER

    nWid = 0
    hotWid = -1
    by = cpY + 4

    '--- tools: labels match their key bindings ------------------------
    FOR i = 0 TO NTOOLS - 1
        AddWid 4 + i * 30, by, 28, 20, WK_TOOL, UI_TOOL, i, ToolCh$(i), ToolTip$(i)
    NEXT

    '--- actions -------------------------------------------------------
    bx = 304
    AddWid bx + 0 * 24, by, 22, 20, WK_BUTTON, UI_UNDO, 0, "U", "Undo"
    AddWid bx + 1 * 24, by, 22, 20, WK_BUTTON, UI_REDO, 0, "R", "Redo"
    AddWid bx + 2 * 24, by, 22, 20, WK_BUTTON, UI_CLEAR, 0, "K", "Clear to bg"
    AddWid bx + 3 * 24, by, 22, 20, WK_TOGGLE, UI_SYM, 0, "/", "Symmetry"
    AddWid bx + 4 * 24, by, 22, 20, WK_TOGGLE, UI_GRID, 0, "#", "Grid snap"
    AddWid bx + 5 * 24, by, 22, 20, WK_TOGGLE, UI_CYCLE, 0, "~", "Cycle colours"
    AddWid bx + 6 * 24, by, 22, 20, WK_BUTTON, UI_ZOOMIN, 0, ">", "Zoom in"
    AddWid bx + 7 * 24, by, 22, 20, WK_BUTTON, UI_ZOOMOUT, 0, "<", "Zoom out"
    AddWid bx + 8 * 24, by, 22, 20, WK_BUTTON, UI_SAVE, 0, "S", "Save ILBM"
    AddWid bx + 9 * 24, by, 22, 20, WK_BUTTON, UI_LOAD, 0, "L", "Load ILBM"
    AddWid bx + 10 * 24, by, 22, 20, WK_TOGGLE, UI_FULL, 0, "F", "Full screen"
    AddWid bx + 11 * 24, by, 22, 20, WK_BUTTON, UI_QUIT, 0, "X", "Quit"
END SUB

FUNCTION ToolTip$ (i AS INTEGER)
    SELECT CASE i
        CASE 0: ToolTip$ = "Freehand"
        CASE 1: ToolTip$ = "Line"
        CASE 2: ToolTip$ = "Curve"
        CASE 3: ToolTip$ = "Box"
        CASE 4: ToolTip$ = "Filled box"
        CASE 5: ToolTip$ = "Circle"
        CASE 6: ToolTip$ = "Filled circle"
        CASE 7: ToolTip$ = "Ellipse"
        CASE 8: ToolTip$ = "Flood fill"
        CASE 9: ToolTip$ = "Pick colour"
        CASE ELSE: ToolTip$ = ""
    END SELECT
END FUNCTION

'  Is a toggle or tool currently lit? Read from the real state rather
'  than a copy, so the button cannot disagree with the program.
FUNCTION WidLit% (i AS INTEGER)
    WidLit% = 0
    SELECT CASE wid(i).kind
        CASE WK_TOOL
            IF ToolIM%(wid(i).arg) = curIMode THEN WidLit% = -1
        CASE WK_TOGGLE
            SELECT CASE wid(i).act
                CASE UI_SYM: IF symON THEN WidLit% = -1
                CASE UI_GRID: IF gridON THEN WidLit% = -1
                CASE UI_CYCLE: IF cycOn THEN WidLit% = -1
                CASE UI_FULL: IF fsMode THEN WidLit% = -1
            END SELECT
    END SELECT
END FUNCTION

FUNCTION WidAt% (x AS INTEGER, y AS INTEGER)
    DIM i AS INTEGER
    WidAt% = -1
    FOR i = 0 TO nWid - 1
        IF x >= wid(i).wx AND x < wid(i).wx + wid(i).ww THEN
            IF y >= wid(i).wy AND y < wid(i).wy + wid(i).wh THEN
                WidAt% = i
                EXIT FUNCTION
            END IF
        END IF
    NEXT
END FUNCTION

'--- drawing -----------------------------------------------------------
SUB BevelBox (x AS INTEGER, y AS INTEGER, w AS INTEGER, h AS INTEGER, _
              face AS INTEGER, sunk AS INTEGER)
    DIM tl AS INTEGER, br AS INTEGER
    IF sunk THEN
        tl = UIC_SHADOW: br = UIC_LIGHT
    ELSE
        tl = UIC_LIGHT: br = UIC_SHADOW
    END IF
    LINE (x, y)-(x + w - 1, y + h - 1), face, BF
    LINE (x, y)-(x + w - 1, y), tl
    LINE (x, y)-(x, y + h - 1), tl
    LINE (x, y + h - 1)-(x + w - 1, y + h - 1), br
    LINE (x + w - 1, y)-(x + w - 1, y + h - 1), br
END SUB

SUB DrawWidgets
    DIM i AS INTEGER, face AS INTEGER, lit AS INTEGER
    DIM tx AS INTEGER, ty AS INTEGER

    hotWid = WidAt%(mouseRX, mouseRY)

    FOR i = 0 TO nWid - 1
        lit = WidLit%(i)

        IF wid(i).act = UI_QUIT THEN
            face = UIC_DANGER
        ELSEIF lit THEN
            face = UIC_LIT
        ELSEIF i = hotWid THEN
            face = UIC_HOVER
        ELSE
            face = UIC_FACE
        END IF

        '  A lit widget reads as pressed in, which is what a toggle or a
        '  selected tool actually is.
        BevelBox wid(i).wx, wid(i).wy, wid(i).ww, wid(i).wh, face, lit

        '  A lit button has a light face, so its label has to go dark
        '  or it washes out.
        IF lit THEN COLOR UIC_SHADOW, face ELSE COLOR UIC_TEXT, face
        tx = wid(i).wx + wid(i).ww \ 2 - 4
        ty = wid(i).wy + (wid(i).wh - 16) \ 2
        _PRINTSTRING (tx, ty), LEFT$(RTRIM$(wid(i).label), 1)
    NEXT
END SUB

'  Floating label above the panel. Drawn over the canvas on screenH, so
'  it never touches hidbm and cannot end up in the artwork.
SUB DrawTip
    DIM s AS STRING, x AS INTEGER, y AS INTEGER, w AS INTEGER
    IF hotWid < 0 THEN EXIT SUB
    s = RTRIM$(wid(hotWid).tip)
    IF LEN(s) = 0 THEN EXIT SUB
    w = LEN(s) * 8 + 6
    x = wid(hotWid).wx
    IF x + w > SCRW THEN x = SCRW - w
    IF x < 0 THEN x = 0
    y = cpY - 20
    BevelBox x, y, w, 19, UIC_FACE, 0
    COLOR UIC_TEXT, UIC_FACE
    _PRINTSTRING (x + 3, y + 2), s
END SUB

'--- dispatch ----------------------------------------------------------
SUB DoWid (i AS INTEGER, but AS INTEGER)
    DIM svpnt AS INTEGER
    IF i < 0 OR i >= nWid THEN EXIT SUB

    '  Anything that can change the mode or the picture has to bracket
    '  the feedback, exactly as MainCproc does for the keyboard.
    svpnt = Painting
    ClearFB

    SELECT CASE wid(i).act
        CASE UI_TOOL: NewIMode ToolIM%(wid(i).arg)
        CASE UI_UNDO: Undo
        CASE UI_REDO: Redo
        CASE UI_CLEAR: mClearToBg
        CASE UI_SYM: TogSymSt
        CASE UI_GRID: TogGridSt
        CASE UI_CYCLE: TogColCyc
        CASE UI_SAVE: DoSaveLBM
        CASE UI_LOAD: DoLoadLBM
        CASE UI_FULL: TogFullScreen
        CASE UI_ZOOMIN: MWZoom 1
        CASE UI_ZOOMOUT: MWZoom -1
        CASE UI_QUIT: ReqQuit
    END SELECT

    IF svpnt THEN UpdtON ELSE UpdtOFF
    ShowFB
END SUB
