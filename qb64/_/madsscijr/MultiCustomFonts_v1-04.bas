Sub SimpleFontTest
    Dim RoutineName As String: RoutineName = "SimpleFontTest"
    Dim MyError$: MyError$ = ""
    Dim DefaultFontHandle&
    Dim FontHandle&
    Dim fontFile$: fontFile$ = m_ProgramPath$ + m_ProgramName$ + ".font.bdf"
    Dim utf32_Default&, utf255_Default&
    Dim iLoop As Integer
    Dim r%, g%, b%

    DefaultFontHandle& = _Font ' REMEMBER DEFAULT FONT
    utf32_Default& = _MapUnicode(32) ' REMEMBER DEFAULT CHAR MAPPING
    utf255_Default& = _MapUnicode(255) ' REMEMBER DEFAULT CHAR MAPPING
    MyError$ = CreateBDF$(fontFile$, 16, 16) ' CREATE FONT FILE
    If Len(MyError$) > 0 Then GoTo ErrorHandler
    FontHandle& = _LoadFont(fontFile$, 16, "monospace") ' LOAD FONT
    If FontHandle& = 0 Then MyError$ = " _LoadFont returned FontHandle 0": GoTo ErrorHandler
    Screen _NewImage(800, 600, 32): _ScreenMove 0, 0 ' INIT SCREEN
    Cls , _RGB32(0, 0, 0): Color _RGB32(0, 255, 255)
    Locate 1, 1: Print "Test of 16x16 font"
    Locate 3, 1: Print "Font file: " + fontFile$
    Locate 20, 1: Print "Press any key to continue"
    _Font FontHandle& ' SWITCH TO CUSTOM FONT
    _MapUnicode 32 To 32 ' FIX CHAR MAPPING (I WAS GETTING WEIRD CHARACTERS FOR SPACE)
    _MapUnicode 255 To 255 ' FIX CHAR MAPPING SO WE GET CHR$(255)
    Locate 5, 1
    Randomize Timer
    For iLoop = 33 To 255
        r% = RandomNumber%(0, 255): g% = RandomNumber%(0, 255): b% = RandomNumber%(0, 255)
        Color _RGB32(r%, g%, b%): Print Chr$(iLoop);
    Next iLoop
    Sleep
    _KeyClear: _Delay 1
    _Font DefaultFontHandle& ' RESTORE DEFAULT FONT
    _MapUnicode 32 To utf32_Default& ' RESTORE DEFAULT CHAR MAPPING
    _MapUnicode 255 To utf255_Default& ' RESTORE DEFAULT CHAR MAPPING
    _Font DefaultFontHandle& ' SWITCH BACK TO DEFAULT FONT
    If FontHandle& > 0 Then _FreeFont FontHandle& ' FREE MEMORY
    Screen 0 ' RESTORE SCREEN 0
    Exit Sub

    ErrorHandler:
    Print RoutineName + " failed with error: " + MyError$
End Sub ' SimpleFontTest

' /////////////////////////////////////////////////////////////////////////////
' Shows how characters can be layered and used as multicolor sprites

Sub AnimationTest
    Dim RoutineName As String: RoutineName = "AnimationTest"
    Dim MyError$: MyError$ = ""
    Dim DefaultFontHandle&
    Dim FontHandle&
    Dim fontFile$: fontFile$ = m_ProgramPath$ + m_ProgramName$ + ".font.bdf"
    Dim utf32_Default&, utf255_Default&
    Dim iLoop1, iLoop2 As Integer
    ReDim arrSprite(0 To 15) As SpriteType

    DefaultFontHandle& = _Font ' REMEMBER DEFAULT FONT
    utf32_Default& = _MapUnicode(32) ' REMEMBER DEFAULT CHAR MAPPING
    utf255_Default& = _MapUnicode(255) ' REMEMBER DEFAULT CHAR MAPPING
    MyError$ = CreateBDF$(fontFile$, 32, 32) ' CREATE FONT FILE
    If Len(MyError$) > 0 Then GoTo ErrorHandler
    FontHandle& = _LoadFont(fontFile$, 32, "monospace") ' LOAD FONT
    If FontHandle& = 0 Then MyError$ = " _LoadFont returned FontHandle 0": GoTo ErrorHandler
    Screen _NewImage(640, 480, 32): _ScreenMove 0, 0 ' INIT SCREEN
    Cls , _RGB32(0, 0, 0)
    _Font FontHandle& ' SWITCH TO CUSTOM FONT
    _MapUnicode 32 To 32 ' FIX CHAR MAPPING (I WAS GETTING WEIRD CHARACTERS FOR SPACE)
    _MapUnicode 255 To 255 ' FIX CHAR MAPPING SO WE GET CHR$(255)

    ' INIT "SPRITES"
    For iLoop1 = LBound(arrSprite) To UBound(arrSprite) Step 4
        arrSprite(iLoop1 + 0).BgChar = 145
        arrSprite(iLoop1 + 0).FgChar = 151
        arrSprite(iLoop1 + 0).BgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 0).FgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 0).xPos = RandomNumber%(0, 800)
        arrSprite(iLoop1 + 0).yPos = RandomNumber%(0, 600)

        arrSprite(iLoop1 + 1).BgChar = 193
        arrSprite(iLoop1 + 1).FgChar = 192
        arrSprite(iLoop1 + 1).BgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 1).FgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 1).xPos = RandomNumber%(0, 800)
        arrSprite(iLoop1 + 1).yPos = RandomNumber%(0, 600)

        arrSprite(iLoop1 + 2).BgChar = 147
        arrSprite(iLoop1 + 2).FgChar = 241
        arrSprite(iLoop1 + 2).BgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 2).FgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 2).xPos = RandomNumber%(0, 800)
        arrSprite(iLoop1 + 2).yPos = RandomNumber%(0, 600)

        arrSprite(iLoop1 + 3).BgChar = 154
        arrSprite(iLoop1 + 3).FgChar = 243
        arrSprite(iLoop1 + 3).BgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 3).FgColor = _RGB32(RandomNumber%(0, 255), RandomNumber%(0, 255), RandomNumber%(0, 255))
        arrSprite(iLoop1 + 3).xPos = RandomNumber%(0, 800)
        arrSprite(iLoop1 + 3).yPos = RandomNumber%(0, 600)
    Next iLoop1

    ' DO ANIMATION
    Do
        ' DO EVERY 5 SECONDS
        If ExtendedTimer > NextTime Then
            ' CHANGE DIRECTION FOR ALL
            For iLoop1 = LBound(arrSprite) To UBound(arrSprite) Step 4
                arrSprite(iLoop1 + 0).dx = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 0).dy = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 1).dx = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 1).dy = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 2).dx = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 2).dy = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 3).dx = RandomNumber%(-8, 8)
                arrSprite(iLoop1 + 3).dy = RandomNumber%(-8, 8)
            Next iLoop1

            ' DO IT AGAIN IN 5 SECONDS
            NextTime = ExtendedTimer + 5
        End If

        ' MOVE = DRAW
        Cls , _RGB32(0, 0, 0)
        Locate 1, 1: Print "PRESS ESC TO EXIT"
        For iLoop1 = LBound(arrSprite) To UBound(arrSprite)
            arrSprite(iLoop1).xPos = arrSprite(iLoop1).xPos + arrSprite(iLoop1).dx
            If arrSprite(iLoop1).xPos < 0 Then arrSprite(iLoop1).xPos = _Width
            If arrSprite(iLoop1).xPos > _Width Then arrSprite(iLoop1).xPos = 0

            arrSprite(iLoop1).yPos = arrSprite(iLoop1).yPos + arrSprite(iLoop1).dy
            If arrSprite(iLoop1).yPos < 0 Then arrSprite(iLoop1).yPos = _Height
            If arrSprite(iLoop1).yPos > _Height Then arrSprite(iLoop1).yPos = 0

            Color arrSprite(iLoop1).BgColor, _RGB32(0, 0, 0, 0)
            _PrintString (arrSprite(iLoop1).xPos, arrSprite(iLoop1).yPos), Chr$(arrSprite(iLoop1).BgChar)

            Color arrSprite(iLoop1).FgColor, _RGB32(0, 0, 0, 0)
            _PrintString (arrSprite(iLoop1).xPos, arrSprite(iLoop1).yPos), Chr$(arrSprite(iLoop1).FgChar)
        Next iLoop1

        _Display

        _Limit 60 ' 60 fps
    Loop Until InKey$ = Chr$(27)
    _KeyClear: _Delay 1
    _AutoDisplay

    _Font DefaultFontHandle& ' RESTORE DEFAULT FONT
    _MapUnicode 32 To utf32_Default& ' RESTORE DEFAULT CHAR MAPPING
    _MapUnicode 255 To utf255_Default& ' RESTORE DEFAULT CHAR MAPPING
    _Font DefaultFontHandle& ' SWITCH BACK TO DEFAULT FONT
    If FontHandle& > 0 Then _FreeFont FontHandle& ' FREE MEMORY
    Screen 0 ' RESTORE SCREEN 0
    Exit Sub

    ErrorHandler:
    Print RoutineName + " failed with error: " + MyError$
End Sub ' AnimationTest

