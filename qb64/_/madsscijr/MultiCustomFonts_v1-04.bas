Option _Explicit

' SCREEN 0 COLOR CONSTANTS, I KNOW THERE'S A WAY TO USE COLOR NAMES IN QB64PE W/O CONSTANTS, DON'T RECALL WHAT IT IS RIGHT NOW :-?
Const cBlackT& = 0
Const cBlueT& = 1
Const cGreenT& = 2
Const cLtBlueT& = 3
Const cRedT& = 4
Const cPurpleT& = 5
Const cOrangeT& = 6
Const cWhiteT& = 7
Const cGrayT& = 8
Const cPeriwinkleT& = 9
Const cLtGreenT& = 10
Const cCyanT& = 11
Const cLtRedT& = 12
Const cPinkT& = 13
Const cYellowT& = 14
Const cLtGrayT& = 15

' UDTs
Type FontInfoType
    FontHandle As Long
    Size As String
    FontFile As String
    FontPath As String
    FontError As String
End Type

Type SpriteType
    BgChar As Integer
    BgColor As _Unsigned Long
    FgChar As Integer
    FgColor As _Unsigned Long
    xPos As Long
    yPos As Long
    dx As Long
    dy As Long
End Type

' BASIC PROGRAM METADATA
Dim Shared m_ProgramPath$: m_ProgramPath$ = Left$(Command$(0), _InStrRev(Command$(0), "\"))
Dim Shared m_ProgramName$: m_ProgramName$ = Mid$(Command$(0), _InStrRev(Command$(0), "\") + 1)

' SCREEN + COLORS
Dim Shared m_iScreenWidth As Long: m_iScreenWidth = 1024 ' _DesktopWidth
Dim Shared m_iScreenHeight As Long: m_iScreenHeight = 768 ' _DesktopHeight
ReDim Shared m_FgColorArray(-1) As _Unsigned Long
ReDim Shared m_BgColorArray(-1) As _Unsigned Long

' FONTS + MAPPING
Dim Shared m_DefaultFontHandle& ' save default font handle
'ReDim Shared m_UtfValueArray(0 To 255) As Long
Dim Shared m_utfValue032_Default&
Dim Shared m_utfValue255_Default&

' OTHER GLOBAL
Dim Shared NextTime As _Float

' INITIALIZE
AddBgColors m_BgColorArray() ' INIT GRAYSCALE COLOR ARRAY
AddFgColors m_FgColorArray() ' INIT SPECTRUM COLOR ARRAY

' RUN TEST
MainMenu

' FINISH
Print m_ProgramName$ + " finished."
End

' /////////////////////////////////////////////////////////////////////////////

Sub MainMenu
    Dim in$
    Dim k$
    Do
        Cls , cBlackT&: Color cLtGrayT&, cBlackT&
        'Print "_PIXELSIZE(0) = " + _ToStr$(_PixelSize(0))

        Print "Custom fixed-width fonts in QB64PE with BDF"
        Print "-------------------------------------------"
        Print
        Print "1   = Simple test with one font"
        Print
        Print "2   = Abbreviated test of all fonts"
        Print
        Print "3   = Full demo with all characters in all fonts (multiple pages, longer)"
        Print
        Print "4   = Simple animation test"
        Print
        Print "Select option or Esc to Quit"
        Do
            k$ = InKey$: _KeyClear
            Select Case k$
                Case "1":
                    SimpleFontTest
                    Exit Do
                Case "2":
                    GenerateFontTest _FALSE
                    Exit Do
                Case "3":
                    GenerateFontTest _TRUE
                    Exit Do
                Case "4":
                    AnimationTest
                    Exit Do
                Case Chr$(27):
                    Exit Do
            End Select
        Loop
        If k$ = Chr$(27) Then Exit Do
    Loop
End Sub ' MainMenu

