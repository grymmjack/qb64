Sub GenerateFontTest (bDisplayAllChars%)
    Dim RoutineName As String: RoutineName = "GenerateFontTest"
    Dim sError As String
    Dim sNextError As String
    ReDim arrFontInfo(0 To 6) As FontInfoType
    Dim iLoop As Integer
    Dim MaxRow As Integer
    Dim MaxCol As Integer
    Dim RowNum As Integer
    Dim ColNum As Integer
    Dim fgColor As _Unsigned Long
    Dim bgColor As _Unsigned Long
    Dim iColorFG As Integer
    Dim iColorBG As Integer
    Dim index%
    Dim bFirst%

    ' INITIALIZE
    sError = ""

    ' REMEMBER DEFAULT FONT
    m_DefaultFontHandle& = _Font

    ' REMEMBER DEFAULT ASC(0-255) MAPPING
    m_utfValue032_Default& = _MapUnicode(32)
    m_utfValue255_Default& = _MapUnicode(255)
    'for index% = 0 to 255
    '    m_UtfValueArray(index%) = _MapUnicode(index%)
    'next index%

    ' GNERATE CUSTOM FONTS
    If Len(sError) = 0 Then
        sError = GenerateFonts$(arrFontInfo())
    End If

    ' DISPLAY FONTS
    If Len(sError) = 0 Then
        ' INITIALIZE COLORS
        AddBgColors m_BgColorArray() ' INIT GRAYSCALE COLOR ARRAY
        AddFgColors m_FgColorArray() ' INIT SPECTRUM COLOR ARRAY

        ' INIT SCREEN
        Screen _NewImage(m_iScreenWidth, m_iScreenHeight, 32)
        _ScreenMove 0, 0

        ' DISPLAY CUSTOM FONTS
        For index% = LBound(arrFontInfo) To UBound(arrFontInfo)
            sNextError = ""

            ' IS THERE A PROBLEM WITH THE NEXT FONT?
            If Len(sNextError) = 0 Then
                If arrFontInfo(index%).FontHandle = 0 Then
                    sNextError = "FontHandle=0"
                End If
                If Len(arrFontInfo(index%).FontError) > 0 Then
                    sNextError = sNextError + _
                        _IIF(len(sNextError)=0, "", ", ") + _
                        "FontError=" + _
                        arrFontInfo(index%).FontError
                End If
                If Len(sNextError) > 0 Then
                    sNextError = "Font " + _
                        chr$(34) + arrFontInfo(index%).FontFile + chr$(34) + _
                        " is invalid: " + _
                        sNextError

                    '' CANCEL TEST
                    'Exit For
                End If
            End If

            ' DIPLAY CHARACTERS IN THE NEXT FONT IN MULTIPLE COLORS
            If Len(sNextError) = 0 Then
                ' SELECT FONT
                _Font arrFontInfo(index%).FontHandle

                '' DEBUG: DISPLAY A POPUP SHOWING THE FONT HANDLE
                '' Syntax: result$ = _INPUTBOX$([title$][, message$][, defaultInput$])
                'dim in$ : in$ = _INPUTBOX$(RoutineName, "Font " + chr$(34) + NoExt$(m_ProgramName$) + ".font.bdf" + chr$(34) + " Created, FontHandle& value:", _ToStr$(FontHandle&) )

                ' MAP ASC(255)
                _MapUnicode 32 To 32
                _MapUnicode 255 To 255

                ' CALCULATE MAXIMUM ROW / COLUMN
                MaxRow = (_Height / _FontHeight) - 8
                MaxCol = (_Width / _FontWidth) - 6

                ' DOESN'T WORK: ENTER FULLSCREEN MODE
                '_FullScreen _SquarePixels
                '_FullScreen _Stretch

                ' DISPLAY CHARACTERS
                bFirst% = _TRUE

                For iLoop = 33 To 255

                    ' SHOW FONT INFO
                    If bFirst% = _TRUE Then
                        RowNum = 0
                        Cls , cBlack
                        Color cCyan, cBlack
                        If bDisplayAllChars% = _TRUE Then
                            ' SHOW FULL NAME
                            'Print "Font " + Chr$(34) + arrFontInfo(index%).FontFile + Chr$(34) + " loaded:"
                            Print arrFontInfo(index%).FontFile + ":"
                        Else
                            ' JUST SHOW DIMENSIONS
                            Print arrFontInfo(index%).Size + ":"
                        End If
                        Print
                        'Print "_PIXELSIZE(0) = " + _ToStr$(_PixelSize(0))

                        bFirst% = _FALSE
                    End If

                    ' SHOW CHARCODE
                    Color cCyan, cBlack
                    Print Right$("   " + _Trim$(Str$(iLoop)), 3) + ": ";

                    ' SHOW NEXT CHAR IN VARIOUS COLORS
                    ColNum = 0
                    For iColorBG = LBound(m_BgColorArray) To UBound(m_BgColorArray)
                        bgColor = m_BgColorArray(iColorBG)
                        For iColorFG = LBound(m_FgColorArray) To UBound(m_FgColorArray)
                            If iColorFG <> iColorBG Then
                                ColNum = ColNum + 1
                                If ColNum < MaxCol Then
                                    fgColor = m_FgColorArray(iColorFG)
                                    Color fgColor, bgColor
                                    Print Chr$(iLoop);
                                Else
                                    ' CONTINUE TO NEXT ROW
                                    'ColNum = 0
                                    'Color cCyan, cBlack : print
                                    'Print "     ";
                                    'RowNum = RowNum + 1
                                    'if RowNum > MaxRow then
                                    '   RowNum = 0
                                    '   Color cCyan, cBlack : Print "PRESS ANY KEY TO CONTINUE";
                                    '   Sleep
                                    '   _KeyClear: '_DELAY 1 ' clear keyboard buffer
                                    '   print
                                    'end if

                                    ' JUST DISPLAY ONE ROW
                                    Exit For
                                End If
                            End If
                        Next iColorFG
                        If ColNum >= MaxCol Then Exit For
                    Next iColorBG

                    ' ADD A LINE BREAK + GOTO NEXT LINE
                    Color cCyan, cBlack: Print
                    RowNum = RowNum + 1

                    ' STOP AT BOTTOM
                    If RowNum > MaxRow Then
                        bFirst% = _TRUE
                        If bDisplayAllChars% = _FALSE Then
                            Exit For
                        Else
                            Color cCyan, cBlack: Print "PRESS ANY KEY TO CONTINUE";
                            Sleep
                            _KeyClear: '_DELAY 1 ' clear keyboard buffer
                        End If
                    End If

                Next iLoop

                ' PROMPT USER
                Color cCyan, cBlack
                Print
                Print "PRESS ANY KEY TO CONTINUE"
                Sleep
                _KeyClear: '_DELAY 1 ' clear keyboard buffer
            End If

            ' ADD ANY ERRORS TO THE FINAL ERROR MESSAGE
            If Len(sNextError) > 0 Then
                sError = sError + _IIf(Len(sError) = 0, "", Chr$(13)) + sNextError
            End If
        Next index%

        '' EXIT FULLSCREEN MODE
        '_FullScreen _Off

    End If

    ' GO BACK TO DEFAULT FONT
    _Font m_DefaultFontHandle&

    ' ERASE FONT HANDLES FOR CUSTOM FONTS
    For index% = LBound(arrFontInfo) To UBound(arrFontInfo)
        If arrFontInfo(index%).FontHandle > 0 Then _FreeFont arrFontInfo(index%).FontHandle
    Next index%

    ' RESTORE DEFAULT ASC(0-255) MAPPING
    _MapUnicode 32 To m_utfValue032_Default&
    _MapUnicode 255 To m_utfValue255_Default&
    ' *** RETURNED ERROR***
    'for index% = 0 to 255
    '    _MapUnicode index% To m_UtfValueArray(index%)
    'next index%

    ' RESTORE SCREEN 0
    Screen 0

    ' SHOW ERRORS
    If Len(sError) <> 0 Then
        Print RoutineName + " failed with error: "
        Print sError
    End If

End Sub ' GenerateFontTest

' /////////////////////////////////////////////////////////////////////////////
' CREATES MULTIPLE BDF FONT FILES
' RETURNS BLANK STRING IF SUCCESSFUL
' ELSE RETURNS ERROR MESSAGE
' RETURNS HANDLES TO FONTS IN BYREF ARRAY PARAMETER arrFontInfo()
' REMEMBER: Free unused font handles with _FREEFONT FontHandle&

Function GenerateFonts$ (arrFontInfo() As FontInfoType)
    Dim RoutineName As String: RoutineName = "GenerateFonts$"
    Dim sError As String
    Dim sNextError As String
    Dim iErrorCount As Integer
    Dim FontFilename$
    Dim style$
    Dim iFontWidth%, iFontHeight%
    Dim sWidth$, sHeight$
    Dim arrFontData%(0 To 7, 0 To 1)
    Dim index%

    ' INITIALIZE
    sError = "": iErrorCount = 0

    ' FILL ARRAY WITH FONT PARAMTERS:
    ' {width},{height}
    FontData: Data 8,8,8,16,16,16,16,32,32,32,32,64,64,64,0,0
    Restore FontData
    index% = LBound(arrFontData%, 1)
    Do
        Read iFontWidth%: If iFontWidth% = 0 Then Exit Do
        Read iFontHeight%: If iFontHeight% = 0 Then Exit Do
        arrFontData%(index%, 0) = iFontWidth%
        arrFontData%(index%, 1) = iFontHeight%
        index% = index% + 1: If index% > UBound(arrFontData%, 1) Then Exit Do
    Loop

    ' GENERATE FONTS
    For index% = LBound(arrFontData%, 1) To UBound(arrFontData%, 1)
        sNextError = ""

        ' GET NEXT FONT DIMENSIONS
        iFontWidth% = arrFontData%(index%, 0)
        iFontHeight% = arrFontData%(index%, 1)

        ' VALUE OF ZERO MEANS END OF DATA
        If iFontWidth% = 0 Or iFontHeight% = 0 Then Exit For

        ' GENERATE FONT FILENAME
        sWidth$ = Right$("00" + _ToStr$(iFontWidth%), 2)
        sHeight$ = Right$("00" + _ToStr$(iFontHeight%), 2)
        FontFilename$ = NoExt$(m_ProgramName$) + ".font_" + sWidth$ + "x" + sHeight$ + ".bdf"

        '' IF FONT FILE NOT FOUND, CREATE IT
        'If Len(sError) = 0 Then
        '    If _FileExists(m_ProgramPath$ + FontFilename$) = _FALSE Then
        '        'sError = "File not found: " + Chr$(34) + FontFilename$ + Chr$(34)
        '        sError = CreateBDF$(m_ProgramPath$ + FontFilename$, iFontWidth%, iFontHeight%)
        '    End If
        'End If

        ' ALWAYS (RE)CREATE FONT FILE
        If Len(sError) = 0 Then
            sNextError = CreateBDF$(m_ProgramPath$ + FontFilename$, iFontWidth%, iFontHeight%)
        End If

        ' LOAD FONT
        If Len(sNextError) = 0 Then
            ' SAVE FILENAME + PATH
            arrFontInfo(index%).FontFile = FontFilename$
            arrFontInfo(index%).FontPath = m_ProgramPath$

            ' SAVE DIMENSIONS
            arrFontInfo(index%).Size = sWidth$ + "x" + sHeight$

            ' LOAD FONT FILE
            style$ = "monospace" ' font style is not case sensitive
            arrFontInfo(index%).FontHandle = _LoadFont(m_ProgramPath$ + FontFilename$, iFontHeight%, style$)

            ' FONT HANDLE VALUE OF 0 MEANS IT DIDN'T LOAD
            ' (PROBABLY SOMETHING WRONG WITH BDF FILE)
            If arrFontInfo(index%).FontHandle = 0 Then
                sNextError = "_LoadFont( " + _
                    chr$(34) + m_ProgramPath$ + FontFilename$ + chr$(34) + ", " + _
                    _tostr$(iFontHeight%) + ", " + _
                    chr$(34) + style$ + chr$(34) + " " + _
                    ")" + _
                    " returned FontHandle& = 0 for" + _
                    " iFontWidth%=" + _tostr$(iFontWidth%) + _
                    " iFontHeight%=" + _tostr$(iFontHeight%)

                arrFontInfo(index%).FontError = sNextError
            End If
        End If

        ' COUNT ANY ERRORS FOR THIS FONT
        If Len(sNextError) > 0 Then
            iErrorCount = iErrorCount + 1

            Print sNextError
            Print "    " + "index%       =" + _ToStr$(index%)
            Print "    " + "iFontWidth%  =" + _ToStr$(iFontWidth%)
            Print "    " + "iFontHeight% =" + _ToStr$(iFontHeight%)
            Print "    " + "FontFilename$=" + Chr$(34) + FontFilename$ + Chr$(34)

            sNextError = sNextError + "; "
            sNextError = sNextError + "index%=" + _ToStr$(index%) + "; "
            sNextError = sNextError + "iFontWidth%  =" + _ToStr$(iFontWidth%) + "; "
            sNextError = sNextError + "iFontHeight% =" + _ToStr$(iFontHeight%) + "; "
            sNextError = sNextError + "FontFilename$=" + Chr$(34) + FontFilename$ + Chr$(34) + "; "

            sError = sError + "(" + _ToStr$(iErrorCount) + ") " + sNextError
        End If
    Next index%

    ' IF THERE WERE ERRORS, SHOW WHERE THEY CAME FROM
    If Len(sError) > 0 Then
        sError = RoutineName + " had " + _ToStr$(iErrorCount) + " errors: " + sError
    End If

    ' RETURN RESULTS
    GenerateFonts$ = sError
End Function ' GenerateFonts$

' /////////////////////////////////////////////////////////////////////////////

Function CreateBDF$ (FontFilename$, iFontWidth%, iFontHeight%)
    Dim RoutineName As String: RoutineName = "CreateBDF_32x32$"
    Dim sError As String: sError = ""
    ReDim arrFontData(255, 63, 15) As Integer ' holds font data for upto 32x32 fonts (256 characters, upto 32 rows, upto 8 bytes per row)

    ' RETRIEVE THE FONT DATA TO CREATE THE BDF FILE WITH
    If Len(sError) = 0 Then
        sError = GetTiles$(arrFontData(), iFontWidth%, iFontHeight%)
    End If

    ' IF NO ERRORS THEN SAVE THE BDF FILE
    If Len(sError) = 0 Then
        sError = SaveBDF$(arrFontData(), FontFilename$, iFontWidth%, iFontHeight%)
    Else
        sError = RoutineName + " failed with error: " + sError
    End If

    CreateBDF$ = sError
End Function ' CreateBDF$

' /////////////////////////////////////////////////////////////////////////////
' GENERATE A BDF FONT FILE FROM THE FONT DATA

Function SaveBDF$ (arrFontData%(), filename$, iFontWidth%, iFontHeight%)
    Dim RoutineName As String: RoutineName = "SaveBDF$"
    Dim sError As String: sError = ""
    Dim CharNum As Integer
    Dim RowNum As Integer
    Dim hexString$
    Dim iByteValue As Integer
    Dim sLine As String
    Dim iBytePos As Integer
    Dim iPixelSize As Integer
    Dim iPointSize As Integer
    Dim iAverageWidth As Integer
    Dim iSWidth As Integer
    Dim MaxRow As Integer
    Dim MaxBytes As Integer

    ' VALIDATE INPUT
    If Len(filename$) = 0 Then
        sError = "filename$ is blank."
        GoTo CleanupAndExit
    End If
    If iFontWidth% = 8 Then
        MaxBytes = 0
    ElseIf iFontWidth% = 16 Then
        MaxBytes = 1
    ElseIf iFontWidth% = 32 Then
        MaxBytes = 7
    ElseIf iFontWidth% = 64 Then
        MaxBytes = 15
    Else
        sError = "iFontWidth% value " + _ToStr$(iFontWidth%) + " not supported."
        GoTo CleanupAndExit
    End If
    'TODO: validate arrFontData% array dimensions against iFontWidth%/iFontHeight%

    ' CALCULATE VALUES
    iPixelSize = _Max(iFontWidth%, iFontHeight%)
    iPointSize = iPixelSize * 10
    iAverageWidth = iFontWidth% * 10
    iSWidth = iFontWidth% * 100
    MaxRow = iFontHeight% - 1

    ' CREATE THE FILE
    Open filename$ For Output As #1

    ' -----------------------------------------------------------------------------
    ' --- BDF Header ---
    ' -----------------------------------------------------------------------------
    ' STARTFONT 2.1 defines the version of this BDF file as version 2.1.
    Print #1, "STARTFONT 2.1"

    ' -----------------------------------------------------------------------------
    ' --- Some comments ---
    ' Lines beginning with the word COMMENT can be inserted within a BDF file.
    ' Anything following the COMMENT keyword on a line is ignored.
    Print #1, "COMMENT /*"
    Print #1, "COMMENT  * A " + _ToStr$(iFontWidth%) + "x" + _ToStr$(iFontHeight%) + " fixed-width font based on the Commodore 64 character set"
    Print #1, "COMMENT  * Generated by Quadventure by Softintheheadware"
    Print #1, "COMMENT  */"

    ' =============================================================================
    ' BEGIN GLOBAL DECLARATIONS
    ' =============================================================================

    ' -----------------------------------------------------------------------------
    ' --- The FONT line ---
    ' -----------------------------------------------------------------------------
    ' FONT -gnu-unifont-medium-r-normal--16-160-75-75-c-80-iso10646-1
    ' defines the font family and face names as an X logical font description.

    ' WORKED FOR 8x8 FONT:
    'Print #1, "FONT -My-Font-Regular-R-Normal--8-80-75-75-P-80-ISO8859-1"

    ' FIRST ATTEMPT AT 8X16 FONT (DOESN'T WORK):
    'Print #1, "FONT -My-Font-Regular-R-Normal--16-160-75-75-P-80-ISO8859-1"

    ' COMPARISON WITH SOME WORKING 8X16 FONTS:
    ' spleen-8x16.bdf       FONT -misc-spleen-medium-r-normal--16-160-72-72-C-80-iso10646-1
    ' ib8x16u.bdf           FONT -IBM-BIOS-Normal-R-Condensed--16-120-96-96-C-80-ISO10646-1
    ' Font8x8.font.bdf      FONT -My-Font-Regular-R-Normal--8-80-75-75-P-80-ISO8859-1

    ' WHAT ARE THE PARAMTERS?

    '          111111111122222222223333333333444444444455555555556666666666 <--- column
    ' 123456789012345678901234567890123456789012345678901234567890123456789 <--- positions
    ' FONT -IBM-BIOS-Normal-R-Condensed--16-120-96-96-C-80-ISO10646-1       <--- example w/parameters

    ' Position(s)   Parameter (my best guess)
    ' -----------   ---------------------------------------------------------
    '  7- 9         FOUNDRY
    ' 11-14         FAMILY_NAME
    ' 16-21         WEIGHT_NAME
    ' 23            SLANT
    ' 25-33         SETWIDTH_NAME
    ' 34-35         (ADD_STYLE_NAME, left blank)
    ' 36-37         PIXEL_SIZE
    ' 39-41         POINT_SIZE
    ' 43-44         RESOLUTION_X
    ' 46-47         RESOLUTION_Y
    ' 49            SPACING (M=monospaced, P=proportional, C="character cell")
    ' 51-52         AVERAGE_WIDTH
    ' 54-61         CHARSET_REGISTRY
    ' 63            CHARSET_ENCODING

    ' USING THE ABOVE, WE CREATE A TEMPLATE AND POPULATE IT
    ' THEN WRITE THE POPULATED FONT LINE
    sLine = "FONT -{FOUNDRY}-{FAMILY_NAME}-{WEIGHT_NAME}-{SLANT}-{SETWIDTH_NAME}-{ADD_STYLE_NAME}-{PIXEL_SIZE}-{POINT_SIZE}-{RESOLUTION_X}-{RESOLUTION_Y}-{SPACING}-{AVERAGE_WIDTH}-{CHARSET_REGISTRY}-{CHARSET_ENCODING}"
    sLine = Replace$(sLine, "{FOUNDRY}", "Softintheheadware")
    sLine = Replace$(sLine, "{FAMILY_NAME}", "Quadventure")
    sLine = Replace$(sLine, "{WEIGHT_NAME}", "Medium")
    sLine = Replace$(sLine, "{SLANT}", "R")
    sLine = Replace$(sLine, "{SETWIDTH_NAME}", "Normal")
    sLine = Replace$(sLine, "{ADD_STYLE_NAME}", "")
    sLine = Replace$(sLine, "{PIXEL_SIZE}", _ToStr$(iPixelSize))
    sLine = Replace$(sLine, "{POINT_SIZE}", _ToStr$(iPointSize))
    sLine = Replace$(sLine, "{RESOLUTION_X}", "72")
    sLine = Replace$(sLine, "{RESOLUTION_Y}", "72")
    sLine = Replace$(sLine, "{SPACING}", "M")
    sLine = Replace$(sLine, "{AVERAGE_WIDTH}", _ToStr$(iAverageWidth))
    sLine = Replace$(sLine, "{CHARSET_REGISTRY}", "ISO8859")
    sLine = Replace$(sLine, "{CHARSET_ENCODING}", "1")
    Print #1, sLine

    ' -----------------------------------------------------------------------------
    ' SIZE 16 75 75
    ' -----------------------------------------------------------------------------
    ' defines this to be a 16 point font,
    ' with an X-axis resolution of 75 dots per inch (dpi)
    ' and a Y-axis resolution of 75 dpi.
    ' This is the norm under X Window.
    sLine = "SIZE {POINT_SIZE} {X_AXIS_RESOLUTION_DPI} {Y_AXIS_RESOLUTION_DPI}"
    sLine = Replace$(sLine, "{POINT_SIZE}", _ToStr$(iPixelSize))
    sLine = Replace$(sLine, "{X_AXIS_RESOLUTION_DPI}", "72")
    sLine = Replace$(sLine, "{Y_AXIS_RESOLUTION_DPI}", "72")
    Print #1, sLine

    ' -----------------------------------------------------------------------------
    ' FONTBOUNDINGBOX 16 16 0 -2
    ' -----------------------------------------------------------------------------
    ' defines a bounding box for the font
    ' of 16 pixels wide by 16 pixels high,
    ' with the lower left-hand corner starting at x = 0 and y = -2.
    sLine = "FONTBOUNDINGBOX {PIXEL_WIDTH} {PIXEL_HEIGHT} {STARTING_X} {STARTING_Y}"
    sLine = Replace$(sLine, "{PIXEL_WIDTH}", _ToStr$(iFontWidth%))
    sLine = Replace$(sLine, "{PIXEL_HEIGHT}", _ToStr$(iFontHeight%))
    sLine = Replace$(sLine, "{STARTING_X}", "0")
    sLine = Replace$(sLine, "{STARTING_Y}", "0")
    Print #1, sLine

    ' -----------------------------------------------------------------------------
    ' STARTPROPERTIES 2 declares that two special properties will follow.
    ' -----------------------------------------------------------------------------
    ' STARTPROPERTIES is optional in the BDF specification.
    sLine = "STARTPROPERTIES {COUNT}"
    sLine = Replace$(sLine, "{COUNT}", "2")
    ' ***NOT USED*** sLine = Replace$(sLine, "{COUNT}", "20")
    Print #1, sLine

    ' -----------------------------------------------------------------------------
    ' ***NOT USED*** ADDED PROPERTIES #1
    ' -----------------------------------------------------------------------------
    If _TRUE = _FALSE Then
        ' FOUNDRY (string)[4] The name of the foundry.
        sLine = "FOUNDRY `Softintheheadware`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' FAMILY_NAME (string)[4] The font family name.
        sLine = "FAMILY_NAME `Quadventure`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' WEIGHT_NAME (string)[4] The weight of this font (“Bold” and “Normal” are typical, though there is no set enumeration).
        'sLine = "WEIGHT_NAME `Normal`"
        sLine = "WEIGHT_NAME `Medium`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' SLANT (string)[4] “R” is roman, “I” is italic, “O” is oblique, “RI” is reverse italic, “RO” is reverse oblique, “OT” is other, and a number indicates polymorphic slant capability.
        sLine = "SLANT `R`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' SETWIDTH_NAME: Proportionate width (e.g. normal, condensed, narrow, expanded/double-wide)
        sLine = "SETWIDTH_NAME `Normal`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' ADD_STYLE_NAME: Additional style (e.g. (Sans) Serif, Informal, Decorated)
        sLine = "ADD_STYLE_NAME ``"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' PIXEL_SIZE: Size of characters, in pixels; 0 (Zero) means a scalable font
        sLine = "PIXEL_SIZE 32"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' POINT_SIZE (integer) See Point (typography).
        ' If it is not separately specified,
        ' EMspace = round(POINT_SIZE/10),
        ' ENspace = round(POINT_SIZE/20), and
        ' THINspace = round(POINT_SIZE/30).
        sLine = "POINT_SIZE 320"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' RESOLUTION_X: Horizontal resolution in dots per inch (DPI), for which the font was designed
        ' RESOLUTION_X (unsigned integer)
        sLine = "RESOLUTION_X 72"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' RESOLUTION_Y (unsigned integer)
        ' RESOLUTION_Y: Vertical resolution, in DPI
        sLine = "RESOLUTION_Y 72"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        'SPACING: monospaced, proportional, or "character cell"
        sLine = "SPACING `M`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        'AVERAGE_WIDTH: Average width of characters of this font; 0 means scalable font
        sLine = "AVERAGE_WIDTH 320"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        'CHARSET_REGISTRY: Registry defining this character set
        'sLine = "CHARSET_REGISTRY `ISO10646`"
        sLine = "CHARSET_REGISTRY `ISO8859`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        'CHARSET_ENCODING: Registry's character encoding scheme for this set
        sLine = "CHARSET_ENCODING `1`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' FACE_NAME (string[4]) The name of the face for this font.
        sLine = "FACE_NAME `Quadventure 32x32`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine

        ' FONT_VERSION (string)[4] The version of the font.
        sLine = "FONT_VERSION `001.000`"
        sLine = Replace$(sLine, "`", Chr$(34))
        Print #1, sLine
    End If

    ' -----------------------------------------------------------------------------
    ' X Window allows the properties FONT_ASCENT and FONT_DESCENT
    ' to show the height above and below the baseline, respectively, for all glyphs.
    ' -----------------------------------------------------------------------------
    ' FONT_ASCENT (integer) The height above the baseline, for line spacing calculation.
    ' FONT_ASCENT 14 declares that 14 of the 16 pixels in height are above the baseline.
    sLine = "FONT_ASCENT {NUM_PIXELS_ABOVE_BASELINE}" ' FONT_ASCENT and FONT_DESCENT to show the height above and below the baseline, respectively, for all glyphs.
    sLine = Replace$(sLine, "{NUM_PIXELS_ABOVE_BASELINE}", _ToStr$(iFontHeight%))
    Print #1, sLine

    ' FONT_DESCENT (integer) The descender below the baseline, for line spacing calculation.
    ' FONT_DESCENT 2 declares that 2 of the 16 pixels in height are below the baseline.
    sLine = "FONT_DESCENT {NUM_PIXELS_BELOW_BASELINE}"
    sLine = Replace$(sLine, "{NUM_PIXELS_BELOW_BASELINE}", "0")
    Print #1, sLine

    ' -----------------------------------------------------------------------------
    ' ***NOT USED*** ADDED PROPERTIES #2
    ' -----------------------------------------------------------------------------
    If _TRUE = _FALSE Then
        ' X_HEIGHT (integer) The height above the baseline of a lower-case “x” (See x-height).
        sLine = "X_HEIGHT 32"
        Print #1, sLine

        ' CAP_HEIGHT (integer) The height above the baseline of a capital letter (See Cap height).
        sLine = "CAP_HEIGHT 32"
        Print #1, sLine
    End If

    ' -----------------------------------------------------------------------------
    ' *** NOT USED*** SOME OTHER PROPERTIES
    ' -----------------------------------------------------------------------------
    'FONT (string)[4] The X Window name of the font.
    'COPYRIGHT (string)[4] A copyright statement.
    'COPYRIGHT "BDF conversion (c) 2025 user, license: creative commons"
    'DEFAULT_CHAR (unsigned integer) The default character (glyph) to display for an undefined glyph.
    'NOTICE (string)[4] A general comment.

    ' -----------------------------------------------------------------------------
    ' *** NOT USED*** SOME MORE PROPERTIES SEEN IN BDF FILES BUT NOT DOCUMENTED
    '                 ON THE Glyph Bitmap Distribution Format OR X Logical PAGES
    ' -----------------------------------------------------------------------------
    'FONT_NAME "Quadventure16x16"
    'CHARSET_COLLECTIONS "ASCII ISOLatin1Encoding ISO8859-2 ISO8859-5 ISO8859-7 ISO8859-9 ISO8859-8 ISO8859-4 ISO10646-1"
    'FONTNAME_REGISTRY
    'UNDERLINE_POSITION -2
    'UNDERLINE_THICKNESS 1
    'RAW_ASCENT 875
    'RAW_DESCENT 125
    'NORM_SPACE 16
    'RELATIVE_WEIGHT 50
    'RELATIVE_SETWIDTH 50
    'FIGURE_WIDTH 16
    'AVG_LOWERCASE_WIDTH 160
    'AVG_UPPERCASE_WIDTH 160
    'MIN_SPACE 16
    '_GBDFED_INFO "Edited with gbdfed 1.6."

    ' -----------------------------------------------------------------------------
    ' ENDPROPERTIES appears at the end of the STARTPROPERTIES section.
    ' -----------------------------------------------------------------------------
    Print #1, "ENDPROPERTIES"

    ' -----------------------------------------------------------------------------
    ' The global declarations end with the CHARS line.
    ' -----------------------------------------------------------------------------
    ' CHARS declares the # of characters we are defining a glyph for.
    Print #1, "CHARS 256"

    ' =============================================================================
    ' END GLOBAL DECLARATIONS
    ' =============================================================================

    ' =============================================================================
    ' BEGIN CHARACTER DEFINITIONS
    ' =============================================================================
    For CharNum = 0 To 255

        ' -----------------------------------------------------------------------------
        ' STARTCHAR
        ' -----------------------------------------------------------------------------
        ' STARTCHAR U+0041 specifies the start of a character in version 2.1 and earlier,
        ' or of a glyph in version 2.2. The string name of this particular character is
        ' U+0041, expressing in the Unicodeconvention the code point hexadecimal 41
        ' (decimal 65, the ASCII character "A"). In version 2.1 and earlier, the
        ' character name string was limited to 14 characters. In version 2.2, the glyph
        ' name string can contain up to 65,535 characters.
        ' The declarations STARTCHAR through ENDCHARare repeated for each glyph in a font.
        Print #1, "STARTCHAR U+" + Right$("0000" + Hex$(_MapUnicode(CharNum)), 4)

        ' -----------------------------------------------------------------------------
        ' ENCODING
        ' -----------------------------------------------------------------------------
        ' ENCODING 65 declares the decimal code point for this glyph in the font.
        'If CharNum <> 255 Then
        Print #1, "ENCODING " + LTrim$(Str$(_MapUnicode(CharNum)))
        'Else
        '    Print #1, "ENCODING " + LTrim$(Str$(CharNum))
        'End If

        ' -----------------------------------------------------------------------------
        ' SWIDTH
        ' -----------------------------------------------------------------------------
        ' SWIDTH 500 0 declares the scalable width of
        ' 500 on the X-axis and 0 (by default) on the Y-axis.
        ' This will result in an X-axis offset to the next glyph,
        ' but no Y-axis offset to the next glyph
        ' (i.e., the glyphs appear straight across in a line).
        ' The scalable width is 1000 times the actual point size of the character -
        ' the same unit used in an Adobe Font Metric (AFM) file.
        ' The number of pixels calculated as
        '     Pixels = (Scalable Width/1000) * (Resolution/72)
        ' where Scalable Width is 500 in this example,
        ' and resolution is 75 dpi for this font.
        ' Because 75 is approximately equal to 72, the number of pixels is the full width
        ' of a glyph (defined globally as 16 pixels) times (500/1000), or in other words
        ' the width of this glyph is 8 pixels.
        Print #1, "SWIDTH " + _ToStr$(iSWidth) + " 0"

        ' -----------------------------------------------------------------------------
        ' DWIDTH
        ' -----------------------------------------------------------------------------
        ' DWIDTH 8 0 declares the device width of a glyph.
        ' In this case, after the glyph is rendered, the start of the next glyph
        ' is offset 8 pixels on the X-axis and 0 pixels on the Y-axis
        ' from the current glyph origin.
        ' Note that the device width is not necessarily equal to the width of the glyph.
        ' It is simply the offset on the X-axis to move the current point
        ' to the start of the next glyph.
        Print #1, "DWIDTH " + _ToStr$(iFontWidth%) + " 0"

        ' -----------------------------------------------------------------------------
        ' BBX
        ' -----------------------------------------------------------------------------
        ' BBX 8 16 0 -2 declares a bounding box that is 8 pixels wide and 16 pixels tall.
        ' The lower left-hand corner of the character is offset by 0 pixels on the X-axis
        ' and -2 pixels on the Y-axis.
        Print #1, "BBX " + _ToStr$(iFontWidth%) + " " + _ToStr$(iFontHeight%) + " 0 0"

        ' -----------------------------------------------------------------------------
        ' BITMAP
        ' -----------------------------------------------------------------------------
        ' BITMAP begins the bitmap for the current glyph.
        Print #1, "BITMAP"

        ' -----------------------------------------------------------------------------
        ' ONE LINE PER PIXEL
        ' -----------------------------------------------------------------------------
        ' This line must be followed by one line per pixel on the Y-axis.
        ' In this example the glyph is 16 pixels tall, so 16 lines follow.
        ' Each line contains the hexadecimal representation of pixels in a row.
        ' A "1" bit indicates a rendered pixel.
        ' Each line is rounded to an 8 bit (one byte) boundary, padded with zeroes on the right.
        ' In this example, the glyph is exactly 8 pixels wide, and so occupies exactly 8 bits
        ' (one byte) per line so that there is no padding.
        ' The most significant bit of a line of raster data represents the leftmost pixel.

        For RowNum = 0 To MaxRow
            sLine = ""
            For iBytePos = 0 To MaxBytes
                ' Convert next byte in RowNum to hexadecimal string
                iByteValue = arrFontData%(CharNum, RowNum, iBytePos) ' get next row value byte
                hexString$ = "00" + Hex$(iByteValue) ' convert to hex
                hexString$ = _Trim$(hexString$)
                hexString$ = Right$(hexString$, 2) ' Pad to two hex digits
                sLine = sLine + hexString$
            Next iBytePos

            ' SAVE THE BYTES FOR THE NEXT ROW
            Print #1, sLine
        Next RowNum

        ' -----------------------------------------------------------------------------
        ' ENDCHAR ends the current glyph.
        ' -----------------------------------------------------------------------------
        Print #1, "ENDCHAR"
    Next CharNum

    ' =============================================================================
    ' END CHARACTER DEFINITIONS
    ' =============================================================================

    ' -----------------------------------------------------------------------------
    ' --- BDF Footer ---
    ' -----------------------------------------------------------------------------
    ' ENDFONT appears as the last line in the file, after all glyphs in the font
    ' have been enumerated.
    Print #1, "ENDFONT"

    ' CLOSE THE FILE
    Close #1

    CleanupAndExit:
    ' IF ERROR, ADD WHERE IT CAME FROM
    If Len(sError) > 0 Then
        sError = RoutineName + " failed with error: " + sError
    End If

    ' RETURN ANY ERROR MESSAGES
    SaveBDF$ = sError

End Function ' SaveBDF

' /////////////////////////////////////////////////////////////////////////////
' Receives font dimensions iFontWidth%, iFontHeight%
' and retrieves the font data in text format (arrTileText)
' from the function matching the width/height combination (e.g., GetTileText8x8)
' converts it to binary format to be used by SaveBDF
' and returns it in byref array arrFontData%

Function GetTiles$ (arrFontData%(), iFontWidth%, iFontHeight%)
    Dim RoutineName As String: RoutineName = "GetTiles$"
    Dim sError As String: sError = ""
    Dim sCode As String
    ReDim arrTileText(0 To 255) As String
    Dim TileNum As Integer
    ReDim arrLines(-1) As String
    Dim iFromX As Integer
    Dim iFromY As Integer
    Dim sLine As String
    Dim sChar As String
    Dim sBinary As String
    Dim iValue As Integer
    Dim LineNum As Integer
    Dim ub%, lb%
    Dim iStringPos As Integer
    Dim iBytesPerLine As Integer
    Dim iBytePos As Integer
    Dim iMaxPos As Integer
    Dim MaxLine As Integer

    ' GET THE TEXT FONT DATA arrTileText
    ' FOR THE FONT THAT MATcHES iFontWidth%, iFontHeight%
    ' FROM THE APPROPRIATE FUNCTION
    If Len(sError) = 0 Then
        If iFontWidth% = 8 And iFontHeight% = 8 Then
            sCode = "GetTileText8x8"
            GetTileText8x8 arrTileText()
            iBytesPerLine = 1
        ElseIf iFontWidth% = 8 And iFontHeight% = 16 Then
            sCode = "GetTileText8x16"
            GetTileText8x16 arrTileText()
            iBytesPerLine = 1
        ElseIf iFontWidth% = 16 And iFontHeight% = 16 Then
            sCode = "GetTileText16x16"
            GetTileText16x16 arrTileText()
            iBytesPerLine = 2
        ElseIf iFontWidth% = 16 And iFontHeight% = 32 Then
            sCode = "GetTileText16x32"
            GetTileText16x32 arrTileText()
            iBytesPerLine = 2
        ElseIf iFontWidth% = 32 And iFontHeight% = 32 Then
            sCode = "GetTileText32x32"
            GetTileText32x32 arrTileText()
            iBytesPerLine = 8
        ElseIf iFontWidth% = 32 And iFontHeight% = 64 Then
            sCode = "GetTileText32x64"
            GetTileText32x64 arrTileText()
            iBytesPerLine = 8
        ElseIf iFontWidth% = 64 And iFontHeight% = 64 Then
            sCode = "GetTileText64x64"
            GetTileText64x64 arrTileText()
            iBytesPerLine = 16
        Else
            sError = "Width " + _ToStr$(iFontWidth%) + " and height " + _ToStr$(iFontHeight%) + " combination not supported."
        End If
    End If

    ' VALIDATE THE TEXT FONT ARRAY arrTileText
    If Len(sError) = 0 Then
        lb% = LBound(arrTileText)
        ub% = UBound(arrTileText)
        If lb% <> 0 Or ub% <> 255 Then
            sError = sCode + " returned array with invalid boundaries " + _
                "(" + _
                _TRIM$(str$( lb% )) + _
                " - " +_
                _TRIM$(str$( ub% )) + _
                ")"
        End If
    End If

    ' CONVERT THE TEXT FONT arrTileText TO BINARY FORMAT arrFontData%
    If Len(sError) = 0 Then
        ' MAKE SURE ARRAY HAS PROPER DIMENSIONS
        ReDim arrFontData%(0 To 255, 0 To 63, 0 To 15)

        ' MAXIMUM BYTE POSITION
        iMaxPos = iBytesPerLine - 1

        ' MAXIMUM ROW POSITION (IGNORES ANY DATA AFTER THIS ROW)
        MaxLine = iFontHeight% - 1

        ' CONVERT EACH CHARACTER
        For TileNum = 0 To 255
            ' BREAK UP ROWS FOR NEXT CHARACTER
            split arrTileText(TileNum), Chr$(13), arrLines()

            ' PROCESS CHARACTER ROW BY ROW
            LineNum = 0
            For iFromY = LBound(arrLines) To UBound(arrLines)

                ' PROCESS NEXT LINE COLUMN BY COLUMN
                sLine = arrLines(iFromY)
                If Len(sLine) > 0 Then
                    sBinary = ""

                    ' IS NEXT PIXEL A 1 OR A 0 ?
                    For iFromX = 1 To Len(sLine)
                        sChar = Mid$(sLine, iFromX, 1)
                        If sChar = "." Then
                            sBinary = sBinary + "0"
                        Else
                            sBinary = sBinary + "1"
                        End If
                    Next iFromX

                    ' DID WE READ THE CORRECT # OF PIXELS?
                    If Len(sBinary) = iFontWidth% Then
                        ' CONVERT BITS IN NEXT LINE TO BYTES IN arrFontData%
                        iStringPos = 1
                        For iBytePos = 0 To iMaxPos
                            ' SAVE THE NEXT BYTE (8 BITS AT A TIME)
                            iValue = GetIntegerFromBinary%(Mid$(sBinary, iStringPos, 8))
                            arrFontData%(TileNum, LineNum, iBytePos) = iValue
                            iStringPos = iStringPos + 8
                        Next iBytePos
                    Else
                        ' WRONG NUMBER OF BITS, RETURN TILE # AND WHICH LINE
                        LineNum = LineNum + 1
                        sError = "Invalid data for tile " + _Trim$(Str$(TileNum)) + " at line " + _Trim$(Str$(LineNum))
                        sError = _
                            "sBinary=" + chr$(34) + sBinary + chr$(34) + " " + _
                            "(" + _
                            "contains " + _ToStr$(Len(sBinary)) + " characters, " + _
                            "expected " + _ToStr$(iFontWidth%) + " characters" + _
                            ")" + sError

                        ' CANCEL OPERATION
                        Exit For
                    End If
                    LineNum = LineNum + 1
                    If LineNum > MaxLine Then Exit For
                End If
            Next iFromY

            ' IF THERE WAS AN ERROR CANCEL ALL
            If Len(sError) > 0 Then Exit For
        Next TileNum
    End If

    ' IF ERROR, ADD WHERE IT CAME FROM
    If Len(sError) > 0 Then
        sError = RoutineName + " failed with error: " + sError
    End If

    ' RETURN RESULT
    GetTiles$ = sError
End Function ' GetTiles$

